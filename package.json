{
  "name": "instituto-costa-da-mina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Site institucional do Instituto Costa da Mina — Cidade Ademar, Zona Sul de São Paulo.",
  "scripts": {
    "predev": "node scripts/imagens/variantes.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/imagens/variantes.mjs",
    "build": "next build",
    "postbuild": "node scripts/corrigir-prefetch.mjs",
    "start": "node scripts/servir.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verificar": "npm run typecheck && npm test && npm run build && node --test tests/build/*.test.mjs && npm run e2e",
    "pendencias": "node scripts/pendencias.mjs",
    "imagens:baixar": "node scripts/imagens/baixar.mjs",
    "imagens:variantes": "node scripts/imagens/variantes.mjs",
    "e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "e2e:cursos": "node scripts/e2e-cursos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}