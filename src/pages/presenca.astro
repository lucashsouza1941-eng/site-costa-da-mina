---
// Destino do QR Code fixo das aulas. Abrir esta página não registra nada:
// a presença só é aceita com a chamada aberta pela equipe e com a
// identificação da participante.
import Base from '../layouts/Base.astro';
import CabecaPagina from '../components/CabecaPagina.astro';
import { cursosConfigurado } from '../lib/config';
import '../styles/formularios.css';
---

<Base titulo="Registrar presença" descricao="Confirme sua presença na aula do Instituto Costa da Mina.">
  <CabecaPagina sobrelinha="Lista de chamada" titulo="Registrar presença">
    <p>Use o código da sua inscrição ou o WhatsApp cadastrado.</p>
  </CabecaPagina>

  <section class="secao">
    <div class="envelope presenca" data-presenca data-configurado={cursosConfigurado ? 'sim' : 'nao'}>
      <div data-estado aria-live="polite">
        {
          cursosConfigurado ? (
            <p class="carregando">Verificando se há chamada aberta…</p>
          ) : (
            <div class="aviso">
              <h2>Não existe chamada disponível agora</h2>
              <p>A presença só pode ser registrada durante a aula, quando a professora abrir a chamada.</p>
            </div>
          )
        }
      </div>

      <form class="form" data-form novalidate hidden>
        <div class="campo">
          <label for="identificador">Código da inscrição ou WhatsApp</label>
          <input
            class="entrada"
            id="identificador"
            name="identificador"
            required
            maxlength="40"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            placeholder="CDM-ABCD-EFGH ou (11) 91234-5678"
            aria-describedby="dica-identificador erro-identificador"
          />
          <p class="dica" id="dica-identificador">O código aparece na tela de confirmação da inscrição.</p>
          <p class="erro-campo" id="erro-identificador"></p>
        </div>
        <div class="armadilha" aria-hidden="true">
          <label for="site">Deixe este campo em branco</label>
          <input id="site" name="site" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <button class="botao botao--roxo" type="submit" data-enviar>Confirmar presença</button>
        </div>
      </form>

      <div data-resultado tabindex="-1" aria-live="assertive"></div>

      <button class="botao botao--contorno" type="button" data-atualizar hidden>Verificar de novo</button>
    </div>
  </section>
</Base>

<script>
  import '../scripts/presenca';
</script>

<style>
  .presenca {
    display: grid;
    gap: 1.5rem;
    max-width: 34rem;
  }
  .botao--contorno {
    justify-self: start;
    color: var(--roxo-700);
  }
</style>
