---
import Base from '../layouts/Base.astro';
import CabecaPagina from '../components/CabecaPagina.astro';
import Icone from '../components/Icone.astro';
import { rota } from '../lib/rota';
---

<Base titulo="Página não encontrada">
  <CabecaPagina sobrelinha="Erro 404" titulo="Esse caminho não existe.">
    <p>O link pode estar quebrado ou a página mudou de endereço.</p>
  </CabecaPagina>
  <section class="secao">
    <div class="envelope grupo-botoes">
      <a class="botao botao--roxo" href={rota('/')}>Voltar ao início <Icone nome="seta" /></a>
      <a class="botao botao--contorno" href={rota('projetos/')}>Ver projetos</a>
    </div>
  </section>
</Base>
