---
import Base from '../layouts/Base.astro';
import CabecaPagina from '../components/CabecaPagina.astro';
import Pix from '../components/Pix.astro';
import Pendente from '../components/Pendente.astro';
import Icone from '../components/Icone.astro';
import { instituto, linkWhatsApp } from '../data/instituto';
import { projetos } from '../data/projetos';
import { rota } from '../lib/rota';
---

<Base titulo="Contribua" descricao="Apoie os projetos do Instituto Costa da Mina com uma doação via PIX.">
  <CabecaPagina sobrelinha="Contribua" titulo="Contribua com os nossos projetos.">
    <p>Qualquer valor ajuda muito!</p>
  </CabecaPagina>

  <section class="secao">
    <div class="envelope grade">
      <div class="prosa">
        <h2>Como doar</h2>
        <ol class="passos">
          <li>Abra o aplicativo do seu banco e escolha <strong>PIX</strong>.</li>
          <li>Use a chave <strong>CNPJ</strong> do Instituto: <span class="nowrap">{instituto.cnpj}</span>.</li>
          <li>Confira os dados do recebedor e confirme o valor.</li>
        </ol>
        <p class="texto-suave">Quer apoiar de outro jeito, com parceria, material ou trabalho voluntário? Fale com a gente.</p>
        <a class="botao botao--whats" href={linkWhatsApp('Olá! Gostaria de apoiar o Instituto Costa da Mina.')} rel="noopener">
          <Icone nome="whatsapp" /> Conversar no WhatsApp
        </a>
        <Pendente id="nome-juridico" />
        <Pendente id="qr-code" />
      </div>
      <Pix />
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="titulo-apoio">
    <div class="envelope">
      <div class="cabeca-secao">
        <p class="sobrelinha">Para onde vai o apoio</p>
        <h2 id="titulo-apoio">Projetos que você fortalece.</h2>
      </div>
      <ul class="projetos" role="list">
        {
          projetos.map((p) => (
            <li>
              <a href={rota(`projetos/${p.slug}/`)}>
                <strong>{p.nome}</strong>
                <span>{p.chamada}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .grade {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .grade {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
  }
  .grade h2 {
    font-size: var(--t-3);
  }
  .passos {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }
  .passos li::marker {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    color: var(--roxo-700);
  }
  .nowrap {
    white-space: nowrap;
  }
  .projetos {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .projetos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .projetos a {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--raio);
    background: var(--papel);
    border: 1px solid var(--linha);
    text-decoration: none;
  }
  .projetos a:hover {
    border-color: var(--roxo-700);
  }
  .projetos strong {
    font-family: var(--fonte-titulo);
    font-size: var(--t-2);
    color: var(--roxo-700);
  }
  .projetos span {
    color: var(--tinta-suave);
  }
</style>
