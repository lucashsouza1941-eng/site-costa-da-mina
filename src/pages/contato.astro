---
import Base from '../layouts/Base.astro';
import CabecaPagina from '../components/CabecaPagina.astro';
import Pendente from '../components/Pendente.astro';
import Icone from '../components/Icone.astro';
import { instituto, linkWhatsApp, linkMapa } from '../data/instituto';

const canais = [
  {
    icone: 'whatsapp',
    rotulo: 'WhatsApp e celular',
    valor: instituto.whatsapp.exibicao,
    href: linkWhatsApp('Olá! Vim pelo site do Instituto Costa da Mina.'),
    acao: 'Abrir conversa',
  },
  { icone: 'email', rotulo: 'E-mail', valor: instituto.email, href: `mailto:${instituto.email}`, acao: 'Escrever e-mail' },
  {
    icone: 'instagram',
    rotulo: 'Instagram',
    valor: `@${instituto.redes.instagram.usuario}`,
    href: instituto.redes.instagram.url,
    acao: 'Abrir perfil',
  },
] as const;
---

<Base
  titulo="Contato"
  descricao="WhatsApp, e-mail, Instagram e endereço do Instituto Costa da Mina, na Vila Inglesa, Cidade Ademar."
>
  <CabecaPagina sobrelinha="Contato" titulo="Vamos conversar.">
    <p>Fale com o Instituto pelos canais oficiais ou encontre a gente na Vila Inglesa, Cidade Ademar.</p>
  </CabecaPagina>

  <section class="secao">
    <div class="envelope">
      <ul class="canais" role="list">
        {
          canais.map((c) => (
            <li>
              <a href={c.href} rel="noopener">
                <span class="canais__icone">
                  <Icone nome={c.icone} />
                </span>
                <span class="canais__rotulo">{c.rotulo}</span>
                <span class="canais__valor">{c.valor}</span>
                <span class="canais__acao">
                  {c.acao} <Icone nome="seta" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <Pendente id="outras-redes" />
      <Pendente id="whatsapp" />
    </div>
  </section>

  <section class="secao secao--escura" aria-labelledby="titulo-endereco">
    <div class="envelope endereco">
      <div>
        <p class="sobrelinha">Endereço</p>
        <h2 id="titulo-endereco">{instituto.endereco.logradouro}</h2>
        <p class="texto-grande">
          {instituto.endereco.bairro} · {instituto.endereco.distrito}<br />
          {instituto.endereco.cidade} – {instituto.endereco.uf}
        </p>
        <Pendente id="cep" />
        <Pendente id="horario" />
      </div>
      <a class="botao" href={linkMapa} rel="noopener">
        <Icone nome="mapa" /> Ver no mapa
      </a>
    </div>
  </section>
</Base>

<style>
  .canais {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .canais {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .canais a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: var(--raio-g);
    background: var(--papel-2);
    border: 2px solid transparent;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .canais a:hover {
    border-color: var(--roxo-700);
    transform: translateY(-2px);
  }
  .canais__icone {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--roxo-700);
    color: var(--amarelo);
  }
  .canais__icone svg {
    width: 1.6rem;
    height: 1.6rem;
  }
  .canais__rotulo {
    font-size: var(--t-0);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .canais__valor {
    font-family: var(--fonte-titulo);
    font-size: var(--t-2);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .canais__acao {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-weight: 700;
    color: var(--roxo-700);
  }
  .canais__acao svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .endereco {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  .endereco h2 {
    font-size: var(--t-3);
  }
  @media (min-width: 56rem) {
    .endereco {
      grid-template-columns: 1fr auto;
    }
  }
</style>
