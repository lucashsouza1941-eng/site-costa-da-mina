---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tranca from '../../components/Tranca.astro';
import Icone from '../../components/Icone.astro';
import Pendente from '../../components/Pendente.astro';
import CartaoProjeto from '../../components/CartaoProjeto.astro';
import { projetos, type Projeto } from '../../data/projetos';
import { linkWhatsApp } from '../../data/instituto';
import { tons } from '../../lib/tons';
import { arquivo } from '../../lib/rota';

export const getStaticPaths = (() => projetos.map((projeto) => ({ params: { slug: projeto.slug }, props: { projeto } }))) satisfies GetStaticPaths;

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const tom = tons[projeto.tom];
const outros = projetos.filter((p) => p.slug !== projeto.slug);
---

<Base titulo={projeto.nome} descricao={projeto.resumo}>
  <article style={`--tom:${tom.cor};--sobre-tom:${tom.sobre}`}>
    <header class="topo">
      <div class="envelope topo__grade">
        <div>
          <p class="sobrelinha">Projeto</p>
          <h1>{projeto.nome}</h1>
          <p class="topo__chamada">{projeto.chamada}</p>
        </div>
        {
          projeto.marca && (
            <div class="topo__marca">
              <Image src={projeto.marca.src} alt={projeto.marca.alt} width={360} densities={[1, 2]} loading="eager" />
            </div>
          )
        }
      </div>
      <Tranca fundo={tom.cor} cores={['var(--roxo-900)', 'var(--papel)', 'var(--amarelo)']} />
    </header>

    <section class="secao">
      <div class="envelope corpo">
        <div class="prosa">
          {projeto.paragrafos.map((p, i) => <p class={i === 0 ? 'texto-grande' : undefined}>{p}</p>)}
          {projeto.pendencias.map((id) => <Pendente id={id} />)}
        </div>

        <aside class="ficha" aria-label="Ficha do projeto">
          <dl>
            {
              projeto.fichas.map((f) => (
                <div>
                  <dt>{f.rotulo}</dt>
                  <dd>{f.valor}</dd>
                </div>
              ))
            }
          </dl>
          <div class="ficha__acoes">
            <a
              class="botao botao--whats"
              href={linkWhatsApp(`Olá! Quero saber mais sobre o projeto ${projeto.nome}.`)}
              rel="noopener"
            >
              <Icone nome="whatsapp" /> Saber mais no WhatsApp
            </a>
            {
              projeto.links?.map((l) => (
                <a class="botao botao--roxo" href={l.url} rel="noopener">
                  <Icone nome="instagram" /> {l.rotulo}
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <figure class:list={['capa envelope', { 'capa--cartaz': projeto.capaFormato === 'cartaz' }]}>
      <Image
        src={projeto.capa.src}
        alt={projeto.capa.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 72rem) 72rem, 100vw"
      />
    </figure>

    {
      projeto.citacao && (
        <section class="secao citacao" aria-label="Depoimento">
          <figure class="envelope">
            <blockquote>
              <p>“{projeto.citacao.texto}”</p>
            </blockquote>
            <figcaption>
              <strong>{projeto.citacao.autoria}</strong>
              <span>{projeto.citacao.papel}</span>
            </figcaption>
          </figure>
        </section>
      )
    }

    {
      (projeto.video || projeto.fotos.length > 0) && (
        <section class="secao secao--clara" aria-labelledby="titulo-registros">
          <div class="envelope">
            <div class="cabeca-secao">
              <p class="sobrelinha">Registros</p>
              <h2 id="titulo-registros">Imagens do projeto</h2>
            </div>
            <div class="registros">
              {projeto.video && (
                <figure class="registros__video">
                  <video
                    controls
                    playsinline
                    preload="none"
                    poster={arquivo(projeto.video.capa)}
                    width="480"
                    height="848"
                    aria-label={projeto.video.descricao}
                  >
                    <source src={arquivo(projeto.video.src)} type="video/mp4" />
                  </video>
                  <figcaption>{projeto.video.descricao}</figcaption>
                </figure>
              )}
              {projeto.fotos.map((foto) => (
                <figure class="registros__foto">
                  <Image src={foto.src} alt={foto.alt} widths={[320, 560]} sizes="(min-width: 56rem) 20rem, 80vw" />
                  {foto.legenda && <figcaption>{foto.legenda}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <section class="secao" aria-labelledby="titulo-outros">
    <div class="envelope">
      <div class="cabeca-secao">
        <p class="sobrelinha">Outros projetos</p>
        <h2 id="titulo-outros">Continue conhecendo.</h2>
      </div>
      <ul class="outros" role="list">
        {
          outros.map((p) => (
            <li>
              <CartaoProjeto projeto={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .topo {
    background: var(--tom);
    color: var(--sobre-tom);
  }
  .topo .sobrelinha {
    color: inherit;
  }
  .topo__grade {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 2.75rem 2.5rem;
  }
  .topo h1 {
    margin-bottom: 0.75rem;
  }
  .topo__chamada {
    max-width: 30ch;
    font-size: var(--t-2);
    line-height: 1.35;
  }
  .topo__marca {
    justify-self: start;
    width: min(55vw, 15rem);
  }
  .topo__marca img {
    width: 100%;
    border-radius: var(--raio);
  }
  @media (min-width: 56rem) {
    .topo__grade {
      grid-template-columns: 1.6fr 1fr;
      padding-block: 4.5rem 4rem;
    }
    .topo__marca {
      justify-self: end;
      width: 100%;
      max-width: 18rem;
    }
  }

  .corpo {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 56rem) {
    .corpo {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    .ficha {
      position: sticky;
      top: 6rem;
    }
  }

  .ficha {
    padding: 1.5rem;
    border-radius: var(--raio-g);
    background: var(--papel-2);
    border: 2px solid var(--tom);
  }
  .ficha dl {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .ficha dt {
    font-size: var(--t-0);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .ficha dd {
    margin: 0.15rem 0 0;
    font-family: var(--fonte-titulo);
    font-size: var(--t-1);
    font-weight: 650;
    line-height: 1.3;
  }
  .ficha__acoes {
    display: grid;
    gap: 0.75rem;
  }

  .capa {
    margin-block: 0;
  }
  .capa img {
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
    border-radius: var(--raio-g);
  }
  .capa--cartaz img {
    width: auto;
    max-width: 100%;
    max-height: 85vh;
    margin-inline: auto;
    object-fit: contain;
    box-shadow: var(--sombra);
  }

  .citacao blockquote {
    margin: 0;
  }
  .citacao blockquote p {
    max-width: 34ch;
    font-family: var(--fonte-titulo);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 650;
    font-stretch: 90%;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--roxo-700);
  }
  .citacao figcaption {
    display: grid;
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 4px solid var(--amarelo);
  }
  .citacao figcaption span {
    color: var(--tinta-suave);
  }

  /* registros: rolagem lateral no celular, grade no desktop */
  .registros {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 20rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    margin-inline: calc(-1 * var(--margem));
    padding-inline: var(--margem);
    scroll-padding-inline: var(--margem);
  }
  .registros figure {
    margin: 0;
    scroll-snap-align: start;
  }
  .registros img,
  .registros video {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--raio);
    background: var(--roxo-900);
  }
  .registros video {
    aspect-ratio: 9 / 16;
  }
  .registros figcaption {
    margin-top: 0.5rem;
    font-size: var(--t-0);
    color: var(--tinta-suave);
  }
  @media (min-width: 56rem) {
    .registros {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    .registros__video {
      grid-row: span 2;
    }
  }

  .outros {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outros > li {
    display: grid;
  }
  @media (min-width: 48rem) {
    .outros {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
