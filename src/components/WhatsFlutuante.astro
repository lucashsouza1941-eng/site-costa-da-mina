---
import Icone from './Icone.astro';
import { linkWhatsApp } from '../data/instituto';
---

<a class="whats-flutuante" href={linkWhatsApp('Olá! Vim pelo site do Instituto Costa da Mina.')} rel="noopener">
  <Icone nome="whatsapp" />
  <span class="visualmente-oculto">Conversar no WhatsApp</span>
</a>

<style>
  .whats-flutuante {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #1f8a4c;
    color: #fff;
    box-shadow: 0 10px 24px -8px rgb(28 7 36 / 0.55);
    transition: transform 0.15s ease;
  }
  .whats-flutuante:hover {
    transform: scale(1.06);
  }
  .whats-flutuante svg {
    width: 1.9rem;
    height: 1.9rem;
  }
</style>
