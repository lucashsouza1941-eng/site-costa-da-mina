---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import type { Projeto } from '../data/projetos';
import { tons } from '../lib/tons';
import { rota } from '../lib/rota';

interface Props {
  projeto: Projeto;
  nivel?: 'h2' | 'h3';
}

const { projeto, nivel: Titulo = 'h3' } = Astro.props;
const tom = tons[projeto.tom];
---

<article class="cartao" style={`--tom:${tom.cor};--sobre-tom:${tom.sobre}`}>
  <div class="cartao__imagem">
    <Image
      src={projeto.capa.src}
      alt=""
      widths={[360, 560, 760]}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
    />
  </div>
  <div class="cartao__corpo">
    <Titulo class="cartao__nome">
      <a href={rota(`projetos/${projeto.slug}/`)}>{projeto.nome}</a>
    </Titulo>
    <p class="cartao__chamada">{projeto.chamada}</p>
    <span class="cartao__mais" aria-hidden="true">Conhecer <Icone nome="seta" /></span>
  </div>
</article>

<style>
  .cartao {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--raio-g);
    background: var(--tom);
    color: var(--sobre-tom);
    box-shadow: var(--sombra);
    transition: transform 0.2s ease;
  }
  .cartao:hover {
    transform: translateY(-4px);
  }
  .cartao:focus-within {
    outline: 3px solid var(--ouro);
    outline-offset: 3px;
  }
  .cartao__imagem {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--roxo-900);
  }
  .cartao__imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .cartao:hover .cartao__imagem img {
    transform: scale(1.04);
  }
  .cartao__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.4rem 1.4rem;
  }
  .cartao__nome {
    margin: 0;
    font-size: var(--t-3);
    font-stretch: 85%;
  }
  .cartao__nome a {
    text-decoration: none;
  }
  /* o cartão inteiro é clicável, mas só o título é o link */
  .cartao__nome a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cartao__nome a:focus-visible {
    outline: none;
  }
  .cartao__chamada {
    margin: 0;
    line-height: 1.45;
  }
  .cartao__mais {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--fonte-titulo);
    font-weight: 700;
  }
  .cartao__mais svg {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.2s ease;
  }
  .cartao:hover .cartao__mais svg {
    transform: translateX(4px);
  }
</style>
