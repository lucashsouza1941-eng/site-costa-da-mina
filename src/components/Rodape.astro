---
import { Image } from 'astro:assets';
import simbolo from '../assets/marca/simbolo-cadeira.png';
import Icone from './Icone.astro';
import Tranca from './Tranca.astro';
import Pendente from './Pendente.astro';
import { instituto, linkWhatsApp, linkMapa } from '../data/instituto';
import { projetos } from '../data/projetos';
import { rota } from '../lib/rota';

const ano = new Date().getFullYear();
---

<footer class="rodape">
  <Tranca fundo="var(--roxo-950)" cores={['var(--amarelo)', 'var(--lilas)', 'var(--laranja)']} />
  <div class="envelope rodape__grade">
    <div class="rodape__marca">
      <div class="rodape__simbolo">
        <Image src={simbolo} alt="" width={72} densities={[1, 2]} />
      </div>
      <p class="rodape__nome">{instituto.nome}</p>
      <p class="rodape__lema">{instituto.lema.join(' ')}</p>
    </div>

    <div>
      <h2 class="rodape__titulo">Fale com a gente</h2>
      <ul class="rodape__contatos">
        <li>
          <a href={linkWhatsApp()} rel="noopener"><Icone nome="whatsapp" /> {instituto.whatsapp.exibicao}</a>
        </li>
        <li>
          <a href={`mailto:${instituto.email}`}><Icone nome="email" /> {instituto.email}</a>
        </li>
        <li>
          <a href={instituto.redes.instagram.url} rel="noopener"><Icone nome="instagram" /> @{instituto.redes.instagram.usuario}</a>
        </li>
        <li>
          <a href={linkMapa} rel="noopener">
            <Icone nome="mapa" />
            <span>
              {instituto.endereco.logradouro}<br />
              {instituto.endereco.bairro} · {instituto.endereco.distrito}<br />
              {instituto.endereco.cidade} – {instituto.endereco.uf}
            </span>
          </a>
        </li>
      </ul>
      <Pendente id="cep" />
    </div>

    <nav aria-label="Rodapé">
      <h2 class="rodape__titulo">Navegue</h2>
      <ul class="rodape__links">
        <li><a href={rota('sobre/')}>Sobre o Instituto</a></li>
        {
          projetos.map((p) => (
            <li>
              <a href={rota(`projetos/${p.slug}/`)}>{p.nome}</a>
            </li>
          ))
        }
        <li><a href={rota('contribua/')}>Contribua</a></li>
        <li><a href={rota('privacidade/')}>Política de Privacidade</a></li>
      </ul>
    </nav>
  </div>

  <div class="envelope rodape__base">
    <p>© {ano} {instituto.nome} · CNPJ {instituto.cnpj}</p>
    <Pendente id="nome-juridico" />
  </div>
</footer>

<style>
  .rodape {
    background: var(--roxo-950);
    color: var(--papel);
    padding-bottom: 6rem;
  }
  .rodape a {
    text-decoration: none;
  }
  .rodape a:hover {
    text-decoration: underline;
  }
  .rodape__grade {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 2.5rem;
  }
  @media (min-width: 48rem) {
    .rodape__grade {
      grid-template-columns: 1.2fr 1.2fr 1fr;
    }
  }
  .rodape__simbolo {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--amarelo);
  }
  .rodape__simbolo img {
    width: 3.25rem;
  }
  .rodape__nome {
    margin: 0 0 0.25rem;
    font-family: var(--fonte-titulo);
    font-size: var(--t-2);
    font-weight: 750;
  }
  .rodape__lema {
    color: var(--lilas);
    max-width: 22rem;
  }
  .rodape__titulo {
    margin-bottom: 1rem;
    font-size: var(--t-0);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amarelo);
  }
  .rodape ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rodape__contatos {
    display: grid;
    gap: 0.9rem;
  }
  .rodape__contatos a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    overflow-wrap: anywhere;
  }
  .rodape__contatos svg {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    color: var(--amarelo);
  }
  .rodape__links {
    display: grid;
    gap: 0.5rem;
  }
  .rodape__links a {
    display: inline-block;
    padding-block: 0.15rem;
  }
  .rodape__base {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--t-0);
    color: color-mix(in srgb, var(--papel) 70%, transparent);
  }
</style>
