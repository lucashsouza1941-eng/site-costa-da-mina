---
/**
 * Faixa decorativa em forma de trança: três fios em onda, defasados,
 * repetidos na largura toda. Elemento de assinatura do site.
 */
interface Props {
  cores?: [string, string, string];
  fundo?: string;
  altura?: number;
  class?: string;
}

const {
  cores = ['var(--roxo-700)', 'var(--amarelo)', 'var(--laranja)'],
  fundo = 'var(--papel)',
  altura = 36,
  class: classe,
} = Astro.props;

const periodo = 64;
const amplitude = altura * 0.3;
const meio = altura / 2;

function fio(fase: number) {
  const pontos: string[] = [];
  for (let x = -4; x <= periodo + 4; x += 2) {
    const y = meio + amplitude * Math.sin((2 * Math.PI * x) / periodo + fase);
    pontos.push(`${x.toFixed(1)},${y.toFixed(2)}`);
  }
  return `M${pontos.join(' L')}`;
}

const fios = [0, (2 * Math.PI) / 3, (4 * Math.PI) / 3].map(fio);
const id = `tranca-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['tranca', classe]} width="100%" height={altura} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width={periodo} height={altura} patternUnits="userSpaceOnUse">
      {
        fios.map((d, i) => (
          <>
            <path d={d} style={`stroke:${fundo}`} stroke-width={altura * 0.26} fill="none" stroke-linecap="round" />
            <path d={d} style={`stroke:${cores[i]}`} stroke-width={altura * 0.15} fill="none" stroke-linecap="round" />
          </>
        ))
      }
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  .tranca {
    display: block;
    width: 100%;
  }
</style>
