---
import { instituto } from '../data/instituto';
import Icone from './Icone.astro';
---

<div class="pix">
  <p class="pix__rotulo">Chave PIX (CNPJ)</p>
  <p class="pix__chave"><span data-chave>{instituto.cnpj}</span></p>
  <button type="button" class="botao" data-copiar={instituto.cnpj}>
    <Icone nome="copiar" />
    <span data-texto>Copiar chave</span>
  </button>
  <p class="pix__aviso" role="status" aria-live="polite" data-aviso></p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((botao) => {
    const texto = botao.querySelector('[data-texto]');
    const aviso = botao.parentElement?.querySelector('[data-aviso]');
    botao.addEventListener('click', async () => {
      const valor = botao.dataset.copiar ?? '';
      try {
        await navigator.clipboard.writeText(valor);
        if (texto) texto.textContent = 'Chave copiada!';
        if (aviso) aviso.textContent = 'A chave PIX foi copiada. Cole no app do seu banco.';
      } catch {
        if (aviso) aviso.textContent = `Não foi possível copiar automaticamente. A chave é ${valor}.`;
      }
      setTimeout(() => {
        if (texto) texto.textContent = 'Copiar chave';
      }, 3000);
    });
  });
</script>

<style>
  .pix {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: var(--raio-g);
    background: var(--roxo-950);
    color: var(--papel);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--amarelo) 40%, transparent);
  }
  .pix__rotulo {
    margin: 0;
    font-size: var(--t-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amarelo);
    font-weight: 700;
  }
  .pix__chave {
    margin: 0 0 0.5rem;
    font-family: var(--fonte-titulo);
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .pix__aviso {
    margin: 0;
    min-height: 1.5em;
    font-size: var(--t-0);
    color: color-mix(in srgb, var(--papel) 80%, transparent);
  }
</style>
