---
import Tranca from './Tranca.astro';

interface Props {
  sobrelinha: string;
  titulo: string;
  /** Cor de fundo do topo. */
  fundo?: string;
  cor?: string;
  destaque?: string;
}

const { sobrelinha, titulo, fundo = 'var(--roxo-900)', cor = 'var(--papel)', destaque = 'var(--amarelo)' } = Astro.props;
---

<section class="cabeca-pagina" style={`--fundo:${fundo};--cor:${cor};--destaque:${destaque}`}>
  <div class="envelope cabeca-pagina__conteudo">
    <p class="sobrelinha">{sobrelinha}</p>
    <h1>{titulo}</h1>
    <div class="cabeca-pagina__intro">
      <slot />
    </div>
  </div>
  <Tranca fundo={fundo} cores={['var(--amarelo)', 'var(--lilas)', 'var(--laranja)']} />
</section>

<style>
  .cabeca-pagina {
    background: var(--fundo);
    color: var(--cor);
  }
  .cabeca-pagina__conteudo {
    padding-block: 2.75rem 2.5rem;
  }
  .cabeca-pagina .sobrelinha {
    color: var(--destaque);
  }
  .cabeca-pagina h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 1.6rem + 4.6vw, 5.25rem);
  }
  .cabeca-pagina__intro {
    max-width: 40rem;
    font-size: var(--t-2);
    line-height: 1.45;
  }
  .cabeca-pagina__intro:empty {
    display: none;
  }
  @media (min-width: 56rem) {
    .cabeca-pagina__conteudo {
      padding-block: 4.5rem 4rem;
    }
  }
</style>
