---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';

import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
import { instituto } from '../data/instituto';
import { arquivo } from '../lib/rota';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo,
  descricao = `Organização cultural e comunitária da ${instituto.territorio}. ${instituto.lema.join(' ')}`,
  imagem = arquivo('compartilhar.jpg'),
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${instituto.nome}` : `${instituto.nome} · ${instituto.lema.join(' ')}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(imagem, Astro.site);
// Enquanto estiver no endereço temporário, o site não deve ser indexado.
const indexavel = import.meta.env.PUBLIC_INDEXAVEL === 'sim';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#290b35" />
    <link rel="icon" type="image/png" href={arquivo('favicon.png')} />
    <link rel="apple-touch-icon" href={arquivo('apple-touch-icon.png')} />
    <link rel="sitemap" href={arquivo('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={instituto.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
    <WhatsFlutuante />
  </body>
</html>
